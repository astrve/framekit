{# Cinematic Layout - Horizontal movie-style layout #}
{% extends "_base.jinja2" %}
{% import "_macros.jinja2" as macros %}

{% block layout_styles %}
<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
    background: var(--primary);
  }
  
  /* Hero section with horizontal layout - Optimized for 1200px */
  .hero-wrapper {
    display: grid;
    grid-template-columns: 450px 1fr;
    min-height: 100vh;
    background: linear-gradient(90deg, var(--secondary) 0%, var(--primary) 50%);
  }
  
  .poster-sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    background: var(--secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 50px;
    border-right: 2px solid var(--accent);
  }
  
  .poster {
    width: 100%;
    max-width: 350px;
    border-radius: 8px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  
  .content-area {
    padding: 60px 70px;
  }
  
  /* Header styling */
  header {
    margin-bottom: 60px;
    border-bottom: 3px solid var(--accent);
    padding-bottom: 40px;
  }
  
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }
  
  .badge {
    background: var(--accent);
    color: var(--primary);
    padding: 8px 20px;
    font-weight: 900;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 0;
  }
  
  h1 {
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.95;
    margin: 0 0 16px;
    letter-spacing: -0.04em;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--text);
  }
  
  h2 {
    color: var(--accent);
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin: 0 0 12px;
    font-weight: 800;
  }
  
  h3 {
    color: var(--muted);
    font-size: 1rem;
    margin: 8px 0;
  }
  
  /* Section styling */
  section {
    margin-bottom: 50px;
    padding: 30px 0;
    border-bottom: 1px solid var(--line);
  }
  
  section:last-of-type {
    border-bottom: none;
  }
  
  section h2 {
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--accent);
    display: inline-block;
  }
  
  /* Info grid */
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }
  
  .info-card {
    background: var(--card);
    border-left: 4px solid var(--accent);
    padding: 16px 20px;
  }
  
  .info-card.wide {
    grid-column: span 2;
  }
  
  .info-card span {
    display: block;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 8px;
  }
  
  .info-card strong {
    display: block;
    font-size: 1.05rem;
    color: var(--text);
  }
  
  /* Tables */
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 16px;
    table-layout: fixed;
  }
  
  th, td {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  th {
    background: var(--card);
    color: var(--accent);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }
  
  /* Fixed column widths for audio/subtitle tables */
  th:nth-child(1), td:nth-child(1) { width: 30%; } /* Language */
  th:nth-child(2), td:nth-child(2) { width: 25%; } /* Codec/Type */
  th:nth-child(3), td:nth-child(3) { width: 20%; } /* Channels/Format */
  th:nth-child(4), td:nth-child(4) { width: 25%; } /* Bitrate/Additional */
  
  /* MediaInfo */
  .mediainfo {
    margin-top: 40px;
    border: 2px solid var(--line);
    background: var(--card);
    padding: 20px;
  }
  
  summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.9rem;
  }
  
  pre {
    margin-top: 16px;
    padding: 20px;
    background: var(--primary);
    border-left: 4px solid var(--accent);
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  
  /* Responsive */
  @media (max-width: 1024px) {
    .hero-wrapper {
      grid-template-columns: 1fr;
    }
    
    .poster-sidebar {
      position: relative;
      height: auto;
      min-height: 400px;
    }
    
    .content-area {
      padding: 40px 30px;
    }
    
    .info-card.wide {
      grid-column: span 1;
    }
  }
  
  @media (max-width: 640px) {
    .content-area {
      padding: 30px 20px;
    }
    
    h1 {
      font-size: 2.5rem;
    }
    
    .info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
{% endblock %}

{% block content %}
<main>
  <div class="hero-wrapper">
    <aside class="poster-sidebar">
      {% if data.poster_url != '-' %}
        <img class="poster" src="{{ data.poster_url }}" alt="poster">
      {% else %}
        <div class="placeholder">{{ tr('prez.no_poster', default='No poster available') }}</div>
      {% endif %}
    </aside>
    
    <div class="content-area">
      <header>
        <div class="badges">
          {% for badge in data.badges %}<span class="badge">{{ badge }}</span>{% endfor %}
        </div>
        <h1>{{ data.title }}</h1>
        {% if data.season_label != '-' %}<h2 class="season-heading">{{ data.season_label }}</h2>{% endif %}
        {% if data.heading_subtitle != '-' %}<p class="muted"><strong>{{ data.heading_subtitle }}</strong></p>{% endif %}
        {% if data.season_episode_range != '-' %}<h3 class="episode-heading">{{ data.season_episode_range }}</h3>{% endif %}
        {% if data.subtitle_line %}<p class="muted">{{ data.subtitle_line }}</p>{% endif %}
        <strong style="font-size: 1.1rem; display: block; margin-top: 16px;">{{ data.technical_summary }}</strong>
      </header>
      
      {% if data.overview != '-' %}
      <section class="synopsis">
        <h2>{{ tr('prez.section.synopsis', default='Synopsis') }}</h2>
        <p style="font-size: 1.05rem; line-height: 1.7;">{{ data.overview }}</p>
      </section>
      {% endif %}
      
      {% if data.info_fields %}
      <section class="info-section">
        <h2>{{ tr('prez.section.infos', default='Informations') }}</h2>
        {{ macros.render_info_grid(data.info_fields) }}
      </section>
      {% endif %}
      
      {% if data.release_fields %}
      <section class="release-section">
        <h2>{{ tr('prez.section.release', default='Release') }}</h2>
        {{ macros.render_info_grid(data.release_fields) }}
      </section>
      {% endif %}
      
      {% if data.has_metadata_section %}
      <section class="metadata-section">
        <h2>{{ tr('prez.section.metadata', default='Metadata') }}</h2>
        {{ macros.render_metadata(data.metadata_fields, data.cast, data.crew) }}
      </section>
      {% endif %}
      
      {% if data.video_fields %}
      <section class="video-section">
        <h2>{{ tr('prez.section.video', default='Video') }}</h2>
        {{ macros.render_info_grid(data.video_fields) }}
      </section>
      {% endif %}
      
      <section class="audio-section">
        <h2>{{ tr('prez.section.audio', default='Audio') }}</h2>
        {{ macros.render_audio_tracks(data.audio_track_groups) }}
      </section>
      
      <section class="subtitle-section">
        <h2>{{ tr('prez.section.subtitles', default='Subtitles') }}</h2>
        {{ macros.render_subtitle_tracks(data.subtitle_track_groups) }}
      </section>
      
      {{ macros.render_mediainfo(data.has_mediainfo, data.mediainfo_text) }}
    </div>
  </div>
</main>
{% endblock %}