{# Minimal Layout - Clean, spacious design #}
{% extends "_base.jinja2" %}
{% import "_macros.jinja2" as macros %}

{% block layout_styles %}
<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 40px;
    background: var(--primary);
  }
  
  /* Minimal header */
  header {
    text-align: center;
    margin-bottom: 80px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }
  
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-bottom: 30px;
  }
  
  .badge {
    background: transparent;
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 6px 16px;
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    border-radius: 20px;
  }
  
  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    margin: 0 0 20px;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--text);
  }
  
  h2 {
    color: var(--accent);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin: 0 0 12px;
    font-weight: 600;
  }
  
  h3 {
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    margin: 8px 0;
  }
  
  /* Poster centered */
  .poster-container {
    text-align: center;
    margin: 60px 0;
  }
  
  .poster {
    max-width: 300px;
    width: 100%;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  }
  
  /* Sections with generous spacing */
  section {
    margin-bottom: 60px;
    padding: 40px 0;
  }
  
  section h2 {
    text-align: center;
    margin-bottom: 30px;
  }
  
  .synopsis p {
    font-size: 1.1rem;
    line-height: 1.8;
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    color: var(--text);
  }
  
  /* Minimal info grid - Optimized for 1200px */
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 35px;
    margin-top: 30px;
  }
  
  .info-card {
    text-align: center;
    padding: 20px;
  }
  
  .info-card.wide {
    grid-column: span 2;
  }
  
  .info-card span {
    display: block;
    color: var(--muted);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 700;
    margin-bottom: 10px;
  }
  
  .info-card strong {
    display: block;
    font-size: 1rem;
    color: var(--text);
    font-weight: 500;
  }
  
  /* Minimal tables */
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    table-layout: fixed;
  }
  
  th, td {
    padding: 16px 12px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  th {
    color: var(--muted);
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    font-weight: 600;
  }
  
  td {
    color: var(--text);
  }
  
  /* Fixed column widths for audio/subtitle tables */
  th:nth-child(1), td:nth-child(1) { width: 30%; } /* Language */
  th:nth-child(2), td:nth-child(2) { width: 25%; } /* Codec/Type */
  th:nth-child(3), td:nth-child(3) { width: 20%; } /* Channels/Format */
  th:nth-child(4), td:nth-child(4) { width: 25%; } /* Bitrate/Additional */
  
  /* MediaInfo */
  .mediainfo {
    margin-top: 40px;
    border: 1px solid var(--line);
    padding: 20px;
    background: var(--card);
    border-radius: 4px;
  }
  
  summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    text-align: center;
  }
  
  pre {
    margin-top: 20px;
    padding: 20px;
    background: var(--primary);
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
    border-radius: 4px;
  }
  
  /* Responsive */
  @media (max-width: 768px) {
    main {
      padding: 50px 25px;
    }
    
    header {
      margin-bottom: 50px;
    }
    
    section {
      margin-bottom: 40px;
      padding: 30px 0;
    }
    
    .info-card.wide {
      grid-column: span 1;
    }
    
    .synopsis p {
      text-align: left;
    }
  }
</style>
{% endblock %}

{% block content %}
<main>
  <header>
    <div class="badges">
      {% for badge in data.badges %}<span class="badge">{{ badge }}</span>{% endfor %}
    </div>
    <h1>{{ data.title }}</h1>
    {% if data.season_label != '-' %}<h2 class="season-heading">{{ data.season_label }}</h2>{% endif %}
    {% if data.heading_subtitle != '-' %}<p class="muted"><strong>{{ data.heading_subtitle }}</strong></p>{% endif %}
    {% if data.season_episode_range != '-' %}<h3 class="episode-heading">{{ data.season_episode_range }}</h3>{% endif %}
    {% if data.subtitle_line %}<p class="muted">{{ data.subtitle_line }}</p>{% endif %}
    <p style="margin-top: 20px; font-size: 1rem; color: var(--muted);">{{ data.technical_summary }}</p>
  </header>
  
  <div class="poster-container">
    {% if data.poster_url != '-' %}
      <img class="poster" src="{{ data.poster_url }}" alt="poster">
    {% endif %}
  </div>
  
  {% if data.overview != '-' %}
  <section class="synopsis">
    <h2>{{ tr('prez.section.synopsis', default='Synopsis') }}</h2>
    <p>{{ data.overview }}</p>
  </section>
  {% endif %}
  
  {% if data.info_fields %}
  <section class="info-section">
    <h2>{{ tr('prez.section.infos', default='Information') }}</h2>
    {{ macros.render_info_grid(data.info_fields) }}
  </section>
  {% endif %}
  
  {% if data.release_fields %}
  <section class="release-section">
    <h2>{{ tr('prez.section.release', default='Release') }}</h2>
    {{ macros.render_info_grid(data.release_fields) }}
  </section>
  {% endif %}
  
  {% if data.has_metadata_section %}
  <section class="metadata-section">
    <h2>{{ tr('prez.section.metadata', default='Metadata') }}</h2>
    {{ macros.render_metadata(data.metadata_fields, data.cast, data.crew) }}
  </section>
  {% endif %}
  
  {% if data.video_fields %}
  <section class="video-section">
    <h2>{{ tr('prez.section.video', default='Video') }}</h2>
    {{ macros.render_info_grid(data.video_fields) }}
  </section>
  {% endif %}
  
  <section class="audio-section">
    <h2>{{ tr('prez.section.audio', default='Audio') }}</h2>
    {{ macros.render_audio_tracks(data.audio_track_groups) }}
  </section>
  
  <section class="subtitle-section">
    <h2>{{ tr('prez.section.subtitles', default='Subtitles') }}</h2>
    {{ macros.render_subtitle_tracks(data.subtitle_track_groups) }}
  </section>
  
  {{ macros.render_mediainfo(data.has_mediainfo, data.mediainfo_text) }}
</main>
{% endblock %}