{# Glassmorphism Layout - Frosted glass effects with backdrop blur #}
{% extends "_base.jinja2" %}
{% import "_macros.jinja2" as macros %}

{% block layout_styles %}
<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 30px;
    background: var(--primary);
    position: relative;
  }
  
  /* Glass effect utilities */
  .glass {
    background: var(--card);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--line);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  }
  
  /* Header with glass effect */
  header {
    background: var(--card);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 40px;
    margin-bottom: 40px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    text-align: center;
  }
  
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: 24px;
  }
  
  .badge {
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    padding: 8px 18px;
    font-weight: 800;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-radius: 20px;
  }
  
  h1 {
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    line-height: 1.1;
    margin: 0 0 16px;
    letter-spacing: -0.03em;
    font-weight: 800;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }
  
  h2 {
    color: var(--accent);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin: 0 0 12px;
    font-weight: 700;
  }
  
  /* Poster with glass frame */
  .poster-container {
    text-align: center;
    margin: 40px 0;
  }
  
  .poster-frame {
    display: inline-block;
    padding: 20px;
    background: var(--card);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--line);
    border-radius: 24px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
  }
  
  .poster {
    max-width: 350px;
    width: 100%;
    border-radius: 16px;
    display: block;
  }
  
  /* Glass sections */
  section {
    background: var(--card);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 32px;
    margin-bottom: 30px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  }
  
  section h2 {
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 2px solid color-mix(in srgb, var(--accent) 30%, transparent);
    text-align: center;
  }
  
  /* Info grid with glass cards - Optimized for 1200px */
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }
  
  .info-card {
    background: color-mix(in srgb, var(--secondary) 50%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px;
    transition: all 0.3s ease;
  }
  
  .info-card:hover {
    background: color-mix(in srgb, var(--secondary) 70%, transparent);
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }
  
  .info-card.wide {
    grid-column: span 2;
  }
  
  .info-card span {
    display: block;
    color: var(--muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 800;
    margin-bottom: 8px;
  }
  
  .info-card strong {
    display: block;
    font-size: 1rem;
    color: var(--text);
  }
  
  /* Glass tables */
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 16px;
    table-layout: fixed;
  }
  
  th, td {
    padding: 14px 12px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  th {
    background: color-mix(in srgb, var(--secondary) 40%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--accent);
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    font-weight: 800;
  }
  
  /* Fixed column widths for audio/subtitle tables */
  th:nth-child(1), td:nth-child(1) { width: 30%; } /* Language */
  th:nth-child(2), td:nth-child(2) { width: 25%; } /* Codec/Type */
  th:nth-child(3), td:nth-child(3) { width: 20%; } /* Channels/Format */
  th:nth-child(4), td:nth-child(4) { width: 25%; } /* Bitrate/Additional */
  
  tr:hover {
    background: color-mix(in srgb, var(--line) 20%, transparent);
  }
  
  /* Synopsis with glass effect */
  .synopsis p {
    font-size: 1.1rem;
    line-height: 1.75;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }
  
  /* MediaInfo glass */
  .mediainfo {
    background: var(--card);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 24px;
    margin-top: 30px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  }
  
  summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-align: center;
    padding: 12px;
    background: color-mix(in srgb, var(--secondary) 40%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 12px;
    transition: all 0.3s ease;
  }
  
  summary:hover {
    background: color-mix(in srgb, var(--secondary) 60%, transparent);
  }
  
  pre {
    margin-top: 20px;
    padding: 20px;
    background: color-mix(in srgb, var(--primary) 80%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 12px;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
    border: 1px solid var(--line);
  }
  
  /* Responsive */
  @media (max-width: 900px) {
    .info-card.wide {
      grid-column: span 1;
    }
  }
  
  @media (max-width: 640px) {
    main {
      padding: 40px 20px;
    }
    
    header {
      padding: 30px 24px;
    }
    
    section {
      padding: 24px 20px;
    }
    
    .poster-frame {
      padding: 16px;
    }
    
    .synopsis p {
      text-align: left;
    }
  }
</style>
{% endblock %}

{% block content %}
<main>
  <header>
    <div class="badges">
      {% for badge in data.badges %}<span class="badge">{{ badge }}</span>{% endfor %}
    </div>
    <h1>{{ data.title }}</h1>
    {% if data.season_label != '-' %}<h2 class="season-heading">{{ data.season_label }}</h2>{% endif %}
    {% if data.heading_subtitle != '-' %}<p class="muted"><strong>{{ data.heading_subtitle }}</strong></p>{% endif %}
    {% if data.season_episode_range != '-' %}<h3 class="episode-heading">{{ data.season_episode_range }}</h3>{% endif %}
    {% if data.subtitle_line %}<p class="muted">{{ data.subtitle_line }}</p>{% endif %}
    <p style="margin-top: 20px; font-size: 1.05rem; font-weight: 600;">{{ data.technical_summary }}</p>
  </header>
  
  {% if data.poster_url != '-' %}
  <div class="poster-container">
    <div class="poster-frame">
      <img class="poster" src="{{ data.poster_url }}" alt="poster">
    </div>
  </div>
  {% endif %}
  
  {% if data.overview != '-' %}
  <section class="synopsis">
    <h2>{{ tr('prez.section.synopsis', default='Synopsis') }}</h2>
    <p>{{ data.overview }}</p>
  </section>
  {% endif %}
  
  {% if data.info_fields %}
  <section class="info-section">
    <h2>{{ tr('prez.section.infos', default='Informations') }}</h2>
    {{ macros.render_info_grid(data.info_fields) }}
  </section>
  {% endif %}
  
  {% if data.release_fields %}
  <section class="release-section">
    <h2>{{ tr('prez.section.release', default='Release') }}</h2>
    {{ macros.render_info_grid(data.release_fields) }}
  </section>
  {% endif %}
  
  {% if data.has_metadata_section %}
  <section class="metadata-section">
    <h2>{{ tr('prez.section.metadata', default='Metadata') }}</h2>
    {{ macros.render_metadata(data.metadata_fields, data.cast, data.crew) }}
  </section>
  {% endif %}
  
  {% if data.video_fields %}
  <section class="video-section">
    <h2>{{ tr('prez.section.video', default='Video') }}</h2>
    {{ macros.render_info_grid(data.video_fields) }}
  </section>
  {% endif %}
  
  <section class="audio-section">
    <h2>{{ tr('prez.section.audio', default='Audio') }}</h2>
    {{ macros.render_audio_tracks(data.audio_track_groups) }}
  </section>
  
  <section class="subtitle-section">
    <h2>{{ tr('prez.section.subtitles', default='Subtitles') }}</h2>
    {{ macros.render_subtitle_tracks(data.subtitle_track_groups) }}
  </section>
  
  {{ macros.render_mediainfo(data.has_mediainfo, data.mediainfo_text) }}
</main>
{% endblock %}